POSTGRES_DB=splitedge
POSTGRES_USER=splitedge
# Not a real credential. Set your own local-only password after copying this
# file to .env; never commit the real value.
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
# 8081, not 8080: many Windows machines already have something else (for
# example Apache httpd) listening on 8080.
BACKEND_PORT=8081
# The browser always calls the frontend's own origin; the Vite dev server
# proxies /api to VITE_DEV_PROXY_TARGET below, and a production deployment
# would instead serve the backend at this same origin under /api.
VITE_API_BASE_URL=/api
# Development-only: where the Vite dev server's /api proxy forwards requests.
# Never read by the production browser bundle.
VITE_DEV_PROXY_TARGET=http://localhost:8081
DATABASE_URL=postgresql://splitedge:changeme@localhost:5432/splitedge
NBA_SEASON=2025-26
NBA_IMPORT_SEASONS=2023-24,2024-25,2025-26
